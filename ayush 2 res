/* =====================================
   GLOBAL
===================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #f5f0e7;
    color: #2d2924;
    font-family: "Montserrat", sans-serif;
    font-weight: 300;
}

h1,
h2,
h3,
h4 {
    font-family: "Cormorant Garamond", serif;
}

a {
    text-decoration: none;
    color: inherit;
}


/* =====================================
   NAVBAR
===================================== */

header {
    position: absolute;

    width: 100%;

    z-index: 10;

    padding: 28px 6%;

    border-bottom: 1px solid rgba(255,255,255,0.25);
}

nav {
    display: flex;

    justify-content: space-between;

    align-items: center;
}

.logo {
    color: white;

    font-family: "Cormorant Garamond", serif;

    font-size: 26px;

    letter-spacing: 4px;
}

.logo span {
    color: #d5b06a;
}

nav ul {
    display: flex;

    gap: 32px;

    list-style: none;
}

nav ul a {
    color: white;

    font-size: 10px;

    letter-spacing: 2px;

    transition: 0.3s;
}

nav ul a:hover {
    color: #d5b06a;
}

.reserve-top {
    border: 1px solid #d5b06a;

    color: #d5b06a;

    padding: 12px 22px;

    font-size: 10px;

    letter-spacing: 2px;

    transition: 0.3s;
}

.reserve-top:hover {
    background: #d5b06a;

    color: white;
}


/* =====================================
   HERO
===================================== */

.hero {
    height: 100vh;

    min-height: 700px;

    position: relative;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    background:
        url("https://images.unsplash.com/photo-1517248135467-4c7edcad34c4")
        center/cover;
}

.hero-overlay {
    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            rgba(30,20,15,0.45),
            rgba(30,20,15,0.6)
        );
}

.hero-content {
    position: relative;

    z-index: 2;

    max-width: 850px;

    color: white;
}

.small-title,
.section-label {
    color: #b28b48;

    font-size: 10px;

    letter-spacing: 5px;

    margin-bottom: 25px;
}

.hero h1 {
    font-size: clamp(70px, 9vw, 125px);

    line-height: 0.82;

    font-weight: 400;
}

.hero h1 i {
    color: #d7b36b;
}

.hero-description {
    max-width: 560px;

    margin: 40px auto;

    font-size: 14px;

    line-height: 2;

    color: #f2eee7;
}

.gold-button {
    display: inline-block;

    padding: 16px 30px;

    border: 1px solid #d5b06a;

    color: #d5b06a;

    font-size: 10px;

    letter-spacing: 3px;

    transition: 0.4s;
}

.gold-button:hover {
    background: #d5b06a;

    color: white;
}

.scroll {
    position: absolute;

    bottom: 30px;

    color: white;

    font-size: 9px;

    letter-spacing: 4px;
}


/* =====================================
   INTRODUCTION
===================================== */

.introduction {
    padding: 150px 20%;

    text-align: center;

    background: #f5f0e7;
}

.introduction h2 {
    font-size: clamp(45px, 6vw, 75px);

    font-weight: 400;

    line-height: 0.95;

    color: #312b25;
}

.introduction h2 i {
    color: #a57d3d;
}

.intro-text {
    max-width: 650px;

    margin: 40px auto 0;

    color: #776f66;

    line-height: 2;

    font-size: 14px;
}


/* =====================================
   MENU
===================================== */

.menu {
    padding: 140px 9%;

    background: #eee5d7;
}

.menu-heading {
    text-align: center;

    margin-bottom: 90px;
}

.menu-heading h2 {
    font-size: 75px;

    font-weight: 400;

    color: #302a24;
}

.menu-heading h2 i {
    color: #a57d3d;
}

.menu-heading > p:last-child {
    margin-top: 20px;

    color: #776f66;
}


/* =====================================
   CATEGORY
===================================== */

.menu-category {
    max-width: 1150px;

    margin: 0 auto 110px;
}

.category-title {
    display: flex;

    align-items: center;

    gap: 25px;

    margin-bottom: 40px;

    padding-bottom: 20px;

    border-bottom: 1px solid #cfc3b3;
}

.category-title span {
    color: #a57d3d;

    font-size: 11px;

    letter-spacing: 3px;
}

.category-title h3 {
    font-size: 48px;

    font-weight: 400;

    color: #312b25;
}

.category-title h3 i {
    color: #a57d3d;
}


/* =====================================
   FOOD GRID
===================================== */

.food-grid {
    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 35px;
}


/* =====================================
   FOOD CARD
===================================== */

.food-card {
    background: #faf7f1;

    overflow: hidden;

    box-shadow:
        0 10px 35px rgba(80,60,40,0.10);

    transition: 0.4s;
}

.food-card:hover {
    transform: translateY(-8px);

    box-shadow:
        0 20px 45px rgba(80,60,40,0.18);
}

.food-card img {
    width: 100%;

    height: 300px;

    object-fit: cover;

    display: block;

    transition: 0.5s;
}

.food-card:hover img {
    transform: scale(1.04);
}

.food-info {
    padding: 25px 28px 30px;
}

.food-name {
    display: flex;

    justify-content: space-between;

    align-items: baseline;

    gap: 20px;
}

.food-name h4 {
    font-size: 27px;

    font-weight: 500;

    color: #302a24;
}

.food-name span {
    color: #a57d3d;

    font-family: "Cormorant Garamond", serif;

    font-size: 21px;

    white-space: nowrap;
}

.food-info p {
    color: #81786d;

    font-size: 12px;

    line-height: 1.8;

    margin-top: 10px;
}


/* =====================================
   CHEF TABLE
===================================== */

.tasting {
    max-width: 900px;

    margin: 100px auto 0;

    padding: 90px 30px;

    text-align: center;

    background: #f8f3eb;

    border: 1px solid #cbb99d;

    box-shadow:
        0 20px 50px rgba(70,50,30,0.08);
}

.tasting h2 {
    font-size: 65px;

    font-weight: 400;

    color: #302a24;
}

.tasting h2 i {
    color: #a57d3d;
}

.tasting > p:not(.section-label) {
    color: #81786d;

    margin: 15px 0 30px;
}

.price {
    font-family: "Cormorant Garamond", serif;

    color: #a57d3d;

    font-size: 36px;

    margin-bottom: 30px;
}

.price span {
    color: #81786d;

    font-family: "Montserrat", sans-serif;

    font-size: 10px;
}


/* =====================================
   STORY
===================================== */

.story {
    display: grid;

    grid-template-columns: 1fr 1fr;

    min-height: 700px;
}

.story-image {
    background:
        url("https://images.unsplash.com/photo-1550966871-3ed3cdb5ed0c")
        center/cover;
}

.story-content {
    padding: 100px;

    display: flex;

    justify-content: center;

    flex-direction: column;

    background: #d9c6aa;
}

.story-content h2 {
    font-size: 75px;

    line-height: 0.9;

    margin-bottom: 35px;

    color: #302a24;
}

.story-content h2 i {
    color: #8f6b34;
}

.story-content p:not(.section-label) {
    max-width: 450px;

    color: #665b4f;

    line-height: 2;

    font-size: 13px;

    margin-bottom: 20px;
}

.text-link {
    color: #765725;

    font-size: 10px;

    letter-spacing: 3px;

    margin-top: 25px;
}


/* =====================================
   EXPERIENCE
===================================== */

.experience {
    padding: 140px 10%;

    text-align: center;

    background: #f8f4ec;
}

.experience h2 {
    font-size: 70px;

    font-weight: 400;

    margin-bottom: 90px;

    color: #302a24;
}

.experience h2 i {
    color: #a57d3d;
}

.experience-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 60px;
}

.experience-grid h3 {
    color: #a57d3d;

    font-size: 16px;

    margin-bottom: 20px;
}

.experience-grid h4 {
    font-size: 30px;

    font-weight: 400;

    margin-bottom: 15px;

    color: #302a24;
}

.experience-grid p {
    color: #81786d;

    line-height: 1.8;

    font-size: 12px;
}


/* =====================================
   RESERVATION
===================================== */

.reservation {
    padding: 140px 15%;

    text-align: center;

    background: #e5d7c3;
}

.reservation h2 {
    font-size: 70px;

    font-weight: 400;

    margin-bottom: 60px;

    color: #302a24;
}

.reservation h2 i {
    color: #92703a;
}

form {
    max-width: 800px;

    margin: auto;
}

.form-row {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 20px;
}

input,
select {
    width: 100%;

    padding: 18px;

    margin-bottom: 20px;

    background: transparent;

    border: none;

    border-bottom: 1px solid #a99780;

    color: #302a24;

    outline: none;

    font-family: "Montserrat", sans-serif;
}

select {
    appearance: none;
}

input::placeholder {
    color: #766b5e;
}

button {
    margin-top: 25px;

    padding: 17px 35px;

    background: #a57d3d;

    border: 1px solid #a57d3d;

    color: white;

    font-size: 10px;

    letter-spacing: 3px;

    cursor: pointer;

    transition: 0.3s;
}

button:hover {
    background: #765725;
}


/* =====================================
   CONTACT
===================================== */

.contact {
    display: grid;

    grid-template-columns:
        2fr 1fr 1fr;

    gap: 60px;

    padding: 100px 10%;

    background: #f5f0e7;
}

.contact h2 {
    font-size: 55px;

    font-weight: 400;

    margin-bottom: 25px;

    color: #302a24;
}

.contact h2 i {
    color: #a57d3d;
}

.contact p:not(.section-label) {
    color: #776f66;

    line-height: 2;

    font-size: 12px;
}


/* =====================================
   FOOTER
===================================== */

footer {
    padding: 60px;

    text-align: center;

    background: #2f2923;

    color: #eee4d5;
}

.footer-logo {
    font-family: "Cormorant Garamond", serif;

    font-size: 30px;

    letter-spacing: 6px;

    color: #d5b06a;

    margin-bottom: 15px;
}

footer p {
    font-size: 9px;

    letter-spacing: 4px;

    color: #c2b5a4;

    margin-bottom: 30px;
}

footer small {
    color: #938677;

    font-size: 9px;
}


/* =====================================
   RESPONSIVE
===================================== */

@media (max-width: 900px) {

    header {
        position: relative;

        background: #2f2923;
    }

    nav {
        flex-direction: column;

        gap: 25px;
    }

    nav ul {
        flex-wrap: wrap;

        justify-content: center;

        gap: 18px;
    }

    .hero {
        min-height: 650px;
    }

    .introduction {
        padding: 100px 8%;
    }

    .menu {
        padding: 100px 7%;
    }

    .story {
        grid-template-columns: 1fr;
    }

    .story-image {
        height: 500px;
    }

    .story-content {
        padding: 80px 10%;
    }

    .experience-grid {
        grid-template-columns: 1fr;

        gap: 40px;
    }

    .contact {
        grid-template-columns: 1fr;
    }
}


@media (max-width: 600px) {

    .hero h1 {
        font-size: 65px;
    }

    .menu-heading h2,
    .experience h2,
    .reservation h2 {
        font-size: 50px;
    }

    .category-title h3 {
        font-size: 35px;
    }

    .food-grid {
        grid-template-columns: 1fr;
    }

    .food-card img {
        height: 260px;
    }

    .form-row {
        grid-template-columns: 1fr;
    }

    .story-content h2 {
        font-size: 55px;
    }
}